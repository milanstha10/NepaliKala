cat > .gitignore << 'EOF'
# Virtual environment
env/
venv/
*.venv

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Django
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Environment variables / secrets
.env

# macOS
.DS_Store

# Editor/IDE
.vscode/
.idea/
*.swp

# Git
*.orig
EOF